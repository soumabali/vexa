# vexa PostgreSQL backup crontab — BusyBox crond format (Alpine container)
# Copied into /etc/crontabs/root by Dockerfile.backup.
# No user column (BusyBox crond runs as root inside the container).
#
# Daily — 02:00 UTC, keep last 7 days (RETENTION_DAYS is set via compose env)
0 2 * * * /app/backup.sh daily

# Weekly — Sunday 03:00 UTC, keep last 8 weeks
0 3 * * 0 /app/backup.sh weekly
